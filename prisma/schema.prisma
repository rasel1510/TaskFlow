datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

enum Priority {
  low
  medium
  high
  urgent
}

enum Status {
  backlog
  todo
  in_progress
  in_review
  done
}

enum ProjectHealth {
  on_track
  at_risk
  delayed
  completed
}

model Team {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  members     User[]
  projects    Project[]
  invitations TeamInvitation[]

  @@index([slug])
}

enum InviteStatus {
  pending
  accepted
  expired
  revoked
}

model TeamInvitation {
  id          String       @id @default(cuid())
  teamId      String
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email       String
  role        String       @default("MEMBER")
  token       String       @unique
  status      InviteStatus @default(pending)
  invitedById String
  invitedBy   User         @relation("SentTeamInvites", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([teamId, status])
  @@index([email])
  @@index([token])
}

model User {
  id        String    @id @default(cuid())
  name      String
  avatar        String
  role          String
  expertise     String[]  @default([])
  email         String    @unique
  password      String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Tenant Scoping — Exactly one Team per User
  teamId        String?
  team          Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  tasksAssigned Task[]               @relation("TaskAssignee")
  projectsOwned Project[]            @relation("ProjectOwner")
  memberships   ProjectMember[]
  joinRequests  ProjectJoinRequest[]
  comments      Comment[]
  notifications      Notification[]
  sentTeamInvites    TeamInvitation[]    @relation("SentTeamInvites")
  sentProjectInvites ProjectInvitation[] @relation("SentProjectInvites")

  @@index([teamId])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String
  color       String        @default("#2563EB")
  health      ProjectHealth @default(on_track)
  progress    Int           @default(0)
  startDate      DateTime?
  dueDate        DateTime?
  lifecycleState String        @default("ACTIVE")
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Tenant Scoping — Project belongs to a Team
  teamId       String?
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  ownerId      String
  owner        User                 @relation("ProjectOwner", fields: [ownerId], references: [id])
  tasks        Task[]
  members      ProjectMember[]
  joinRequests ProjectJoinRequest[]
  invitations  ProjectInvitation[]

  @@index([lifecycleState])
  @@index([teamId])
}

model ProjectInvitation {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email       String
  role        String       @default("CONTRIBUTOR") // OWNER, LEAD, CONTRIBUTOR, VIEWER
  token       String       @unique
  status      InviteStatus @default(pending)
  invitedById String
  invitedBy   User         @relation("SentProjectInvites", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId, status])
  @@index([email])
  @@index([token])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("CONTRIBUTOR") // OWNER, LEAD, CONTRIBUTOR, VIEWER
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectJoinRequest {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("pending") // pending, approved, rejected
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([projectId, status])
  @@index([userId])
}

model Task {
  id               String    @id @default(cuid())
  taskNumber       String?   // e.g. "TF-001"
  title            String
  description      String?
  status           Status    @default(todo)
  priority         Priority  @default(medium)
  dueDate          DateTime?
  estimate         String?
  labels           String[]  @default([])
  progress         Int?
  commentsCount    Int       @default(0)
  attachmentsCount Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  projectId        String?
  project          Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId       String?
  assignee         User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments         Comment[]
  activities       Activity[]

  // Performance indexes — required for scalable queries
  @@index([assigneeId])                // GET /api/tasks?userId=...
  @@index([projectId, status])         // GET /api/tasks?projectId=...&status=...
  @@index([assigneeId, dueDate])       // upcoming deadlines, overdue checks
  @@index([status])                    // filter by status alone
  @@index([createdAt])                 // ordering
}


model Comment {
  id        String   @id @default(cuid())
  text      String
  reactions String[] @default([])
  createdAt DateTime @default(now())

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])   // load all comments for a task
  @@index([userId])   // load all comments by a user
}

model Activity {
  id        String   @id @default(cuid())
  text      String
  icon      String   @default("🔄")
  createdAt DateTime @default(now())

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])   // load all activities for a task
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // task_assigned, comment_mention, task_overdue, status_change
  title     String
  body      String
  taskId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String   // 6-digit numeric OTP
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}
