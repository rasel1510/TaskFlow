datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Priority {
  low
  medium
  high
  urgent
}

enum Status {
  backlog
  todo
  in_progress
  in_review
  done
}

enum ProjectHealth {
  on_track
  at_risk
  delayed
  completed
}

model User {
  id        String    @id @default(cuid())
  name      String
  avatar    String
  role      String
  email     String    @unique
  password  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tasksAssigned Task[]    @relation("TaskAssignee")
  projectsOwned Project[] @relation("ProjectOwner")
  comments      Comment[]
  notifications Notification[]
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String
  color       String        @default("#2563EB")
  health      ProjectHealth @default(on_track)
  progress    Int           @default(0)
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  ownerId     String
  owner       User          @relation("ProjectOwner", fields: [ownerId], references: [id])
  tasks       Task[]
}

model Task {
  id               String    @id @default(cuid())
  taskNumber       String?   // e.g. "TF-001"
  title            String
  description      String?
  status           Status    @default(todo)
  priority         Priority  @default(medium)
  dueDate          DateTime?
  estimate         String?
  labels           String[]  @default([])
  progress         Int?
  commentsCount    Int       @default(0)
  attachmentsCount Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId       String?
  assignee         User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  subtasks         SubTask[]
  comments         Comment[]
  activities       Activity[]

  // Performance indexes — required for scalable queries
  @@index([assigneeId])                // GET /api/tasks?userId=...
  @@index([projectId, status])         // GET /api/tasks?projectId=...&status=...
  @@index([assigneeId, dueDate])       // upcoming deadlines, overdue checks
  @@index([status])                    // filter by status alone
  @@index([createdAt])                 // ordering
}

model SubTask {
  id        String   @id @default(cuid())
  title     String
  done      Boolean  @default(false)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  reactions String[] @default([])
  createdAt DateTime @default(now())

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])   // load all comments for a task
  @@index([userId])   // load all comments by a user
}

model Activity {
  id        String   @id @default(cuid())
  text      String
  icon      String   @default("🔄")
  createdAt DateTime @default(now())

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])   // load all activities for a task
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // task_assigned, comment_mention, task_overdue, status_change
  title     String
  body      String
  taskId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}
